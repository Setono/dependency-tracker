{
    "name": "setono/dependency-tracker",
    "description": "A Composer plugin that snapshots tracked vendor files so changes are visible in git diff",
    "license": "MIT",
    "type": "composer-plugin",
    "require": {
        "php": "^8.2",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.0",
        "ergebnis/composer-normalize": "^2.50",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Setono\\DependencyTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\DependencyTracker\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "extra": {
        "class": "Setono\\DependencyTracker\\Plugin"
    }
}
